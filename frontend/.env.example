# Copy to frontend/.env.production.local on the server before `npm run build` (gitignored).
#
# Mac/local dev: use .env.local with the LOCAL block only (or leave empty for Vite proxy).

# =============================================================================
# SERVER — production build (uncommented template)
# =============================================================================
VITE_API_BASE=https://hr-backend.parmarketing.co.in

# =============================================================================
# LOCAL development — uncomment on Mac; comment SERVER line above for npm run dev
# =============================================================================
# VITE_API_BASE=
# VITE_API_PROXY_TARGET=http://localhost:8787

# Same-origin production (nginx serves dist + proxies /api): leave VITE_API_BASE empty
# VITE_API_BASE=
