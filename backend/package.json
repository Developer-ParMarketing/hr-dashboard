{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && cp src/db/schema.sql dist/db/schema.sql",
    "start:prod": "node dist/server.js",
    "check:db": "tsx scripts/checkDb.ts",
    "purge:operational": "tsx scripts/purgeOperationalData.ts",
    "restore:people": "tsx scripts/restorePeopleMaster.ts",
    "check:libreoffice": "node scripts/check-libreoffice.mjs",
    "check:python": "node scripts/check-python-deps.mjs",
    "setup:libreoffice": "bash scripts/ensure-libreoffice.sh",
    "setup:python": "bash scripts/ensure-python-deps.sh",
    "postinstall": "node scripts/check-libreoffice.mjs || true; node scripts/check-python-deps.mjs || true"
  },
  "dependencies": {
    "docxtemplater": "^3.71.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pizzip": "^3.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  }
}
