# Copy to backend/.env on the server (gitignored). Never commit real passwords.
# PM2 reads ATTENDANCE_API_PORT from this file (ecosystem.config.cjs).
#
# Mac/local dev: comment the SERVER block below and uncomment the LOCAL block at the bottom.

# =============================================================================
# SERVER — hr.parmarketing.co.in + hr-backend.parmarketing.co.in (uncommented template)
# =============================================================================
NODE_ENV=production
HOST=0.0.0.0
ATTENDANCE_API_PORT=8021

# UI origin only (credentialed CORS). Comma-separate if you add more frontends.
CORS_ORIGIN=https://hr.parmarketing.co.in, http://hr.parmarketing.co.in

# Postgres on the same VPS . Replace CHANGE_ME.
DATABASE_URL=postgres://hr_app:bDLgzoPh1TCChYO169dd6r6rhUSXva3@127.0.0.1:5432/hr_automation

# Required in production (generate: openssl rand -base64 48)
AUTH_SECRET=GB8t/IP/Eh3AQnbWyhptyRinQqInzrB9Tj/G4u3RreMxKbPgtZ1pqa9A7HRASPQ7

AUTH_COOKIE_SECURE=true

APP_NAME=Par HR
APP_URL=https://hr.parmarketing.co.in, http://hr.parmarketing.co.in
APP_LOGIN_URL=https://hr.parmarketing.co.in/login, http://hr.parmarketing.co.in/login

# First deploy only — set a strong password, then create other users in Admin → Logins
AUTH_BOOTSTRAP_EMAIL=hr@parmarketing.agency
AUTH_BOOTSTRAP_PASSWORD=ParView@2026!
AUTH_BOOTSTRAP_NAME=HR Admin
AUTH_BOOTSTRAP_FORCE_PASSWORD_CHANGE=true

# Production login (needs working SMTP below)
LOGIN_EMAIL_OTP=true

# Attendance PDF/Excel on Linux
PYTHON=/usr/bin/python3

# Relieving letter PDF export (after apt install libreoffice)
LIBREOFFICE_PATH=/usr/bin/soffice

# Optional: late / weekly attendance emails
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_TZ=Asia/Kolkata
NOTIFICATIONS_HOUR=8

# Extra leave notify inboxes (comma-separated)
# LEAVE_REQUEST_NOTIFY_EMAILS=

# =============================================================================
# SMTP (required for OTP, password reset, offer/leave mail)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hr@parmarketing.agency
SMTP_PASS=fmdqqhrsjbjthiog
SMTP_FROM=HR Team <hr@parmarketing.agency>
HR_EMAIL=hr@parmarketing.agency

# =============================================================================
# LOCAL development — uncomment this block on your Mac; comment SERVER block above
# =============================================================================
# NODE_ENV=development
# HOST=0.0.0.0
# ATTENDANCE_API_PORT=8787
# CORS_ORIGIN=http://localhost:5173
# DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/hr_automation
# AUTH_COOKIE_SECURE=false
# APP_URL=http://localhost:5173
# APP_LOGIN_URL=http://localhost:5173/login
# LOGIN_EMAIL_OTP=false
# AUTH_SECRET=
# PYTHON=python3
# LIBREOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice

# =============================================================================
# Managed Postgres (instead of 127.0.0.1) — replace DATABASE_URL; do not use both
# =============================================================================
# DATABASE_URL=postgres://USER:PASSWORD@your-db-host:5432/hr_automation?sslmode=require
# PGSSL=true

# Health after PM2: curl -s http://127.0.0.1:8021/health/ready
# Public: https://hr-backend.parmarketing.co.in/health/ready